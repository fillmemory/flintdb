# Without a compilation DB, macOS clangd treats .h as Objective-C++.
# Force C for the engine so struct members like `delete` are identifiers.
---
If:
  PathMatch: .*/c/src/.*\.(c|h)
CompileFlags:
  Add: [-x, c, -std=gnu17]
  Remove: [-xobjective-c++, -xobjective-c, -xc++, -std=gnu++*, -std=c++*]

# Optional: after `cd c && bear -- make`, uncomment to pick up real -I/-D flags.
# CompileFlags:
#   CompilationDatabase: c

# testcase.c is a bundle of mutually exclusive -DTESTCASE_* mains.
# clangd parses it with none of those macros, so includes look unused.
---
If:
  PathMatch: .*/testcase\.c
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  Suppress: unused-includes
